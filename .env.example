# ==========================================
# NEXO RADIO - VARIABLES DE ENTORNO
# ==========================================

# 1. SUPABASE (Base de datos, Autenticación y Almacenamiento)
# Obtén estas claves en https://supabase.com -> Tu Proyecto -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon_publica_aqui

# 2. STREAMING DE AUDIO PÚBLICO (Oyentes)
# En desarrollo: Déjalo vacío para usar el proxy local /api/stream/live
# En producción: URL directa HTTPS de tu Icecast o servidor de streaming (ej. https://stream.tudominio.com/live)
NEXT_PUBLIC_STREAM_URL=

# 3. WEBSOCKET DE TRANSMISIÓN (Locutor en NEXO Studio -> Bridge Server)
# En desarrollo: se conecta a ws://localhost:8000/broadcast
# En producción con SSL (HTTPS): Debe ser WSS seguro (ej. wss://stream.tudominio.com/broadcast)
NEXT_PUBLIC_BRIDGE_WS_URL=

# 4. CONFIGURACIÓN DEL SERVIDOR PUENTE (bridge-server)
# Puerto en el que escucha el bridge-server (por defecto 8000)
BRIDGE_PORT=8000

# URL interna del Bridge Server accesible desde Next.js (si Next.js y el Bridge están en el mismo servidor o red)
BRIDGE_INTERNAL_URL=http://127.0.0.1:8000

# Servidor Icecast upstream opcional (si el Bridge retransmite a un Icecast maestro)
# Formato: http://source:password@icecast-server.com:8000/live
ICECAST_SOURCE_URL=
